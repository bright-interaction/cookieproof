# CookieProof Environment Configuration
# Copy to .env and fill in values before deploying.

# --- Server ---
PORT=3100
DB_PATH=/data/consent-proofs.db
# Trust X-Forwarded-For/X-Real-IP ONLY when the request's socket peer is an
# internal/private address (your reverse proxy). A direct public client's
# forwarding headers are always ignored. Set to "false" to never trust them.
TRUST_PROXY=true
# Optional explicit allowlist of proxy IPs (comma-separated) in addition to the
# private-peer heuristic above. Leave blank for the default (internal peers only).
TRUSTED_PROXY_IPS=

# --- API Authentication ---
COOKIEPROOF_API_KEY=
# REQUIRED: HMAC signing secret for session JWTs (min 32 chars). The app refuses
# to start without it. Generate: openssl rand -hex 32
JWT_SECRET=

# --- Webhooks ---
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Email (at least one required for verification, password reset, alerts) ---
# Option A: Resend (preferred)
RESEND_API_KEY=
RESEND_FROM=CookieProof <noreply@send.yourdomain.com>

# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# REQUIRED to store per-agency SMTP passwords (AES-256-GCM at rest). Without it,
# saving an agency SMTP password is refused (never stored in plaintext).
# Generate: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# --- Billing (Mollie — required in production) ---
# In production the app refuses to start without MOLLIE_API_KEY (a missing key
# would otherwise let any org self-grant a paid plan for free).
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=https://yourdomain.com/api/billing/webhook
MOLLIE_REDIRECT_URL=https://yourdomain.com/billing
# Dev only: set to "1" (with NODE_ENV != production) to auto-activate subscriptions
# without Mollie for local testing. Has no effect in production.
COOKIEPROOF_DEV_BILLING=

# --- CORS (comma-separated allowed origins) ---
ALLOWED_ORIGINS=https://yourdomain.com

# --- Admin ---
ADMIN_EMAIL=admin@yourdomain.com

# --- PDF Generation ---
GOTENBERG_URL=http://gotenberg:3000

# --- Data Retention (days, default 1095 = 3 years) ---
RETENTION_DAYS=1095

# --- Alerts ---
ALERT_CHECK_INTERVAL_HOURS=6
ALERT_EMAIL_ENABLED=true
